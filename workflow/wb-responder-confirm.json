    {
      "id": "mode-router-000001",
      "name": "Mode Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ],
      "parameters": {
        "jsCode": "// Node: Mode Router — triple gate for real-send (default: dry).\n// real = (mode === \"real\") AND (confirm === true) AND ($env.WB_ALLOW_REAL === \"1\"); otherwise dry.\nvar src = $(\"Webhook\").first().json;\nvar body = src.body || src;\nif (typeof body === \"string\") { try { body = JSON.parse(body); } catch (e) { body = {}; } }\nvar mode = String(body.mode || \"dry\").toLowerCase();\nvar confirmReal = body.confirm === true || body.confirm === \"true\";\nvar allowReal = String($env.WB_ALLOW_REAL || \"\") === \"1\";\nvar real = mode === \"real\" && confirmReal && allowReal;\nvar reason = real ? \"real\" : \"dry\";\nif (mode === \"real\" && !confirmReal) reason += \" (gate: confirm!=true)\";\nelse if (mode === \"real\" && confirmReal && !allowReal) reason += \" (gate: WB_ALLOW_REAL!=1)\";\nreturn [{ json: { real: real, mode: mode, reason: reason } }];"
      }
    },
