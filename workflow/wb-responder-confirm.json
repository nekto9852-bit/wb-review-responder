    {
      "id": "prep-items-000001",
      "name": "Prepare Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1380,
        460
      ],
      "parameters": {
        "jsCode": "// Node: Prepare Items (real path) — parse drafts CSV; skip reviewIds already sent=true (idempotency).\nvar src = $(\"Webhook\").first().json;\nvar body = src.body || src;\nif (typeof body === \"string\") { body = JSON.parse(body); }\nvar csvText = String(body.csv || \"\");\nvar lines = csvText.trim().split(\"\\n\");\nvar sentIds = {};\ntry {\n  var prev = $(\"Parse Sent Log\").all();\n  for (var p = 0; p < prev.length; p++) {\n    var r = prev[p].json;\n    if (String(r.sent).toLowerCase() === \"true\") sentIds[String(r.reviewId)] = true;\n  }\n} catch (e) { /* no previous log file — nothing sent yet */ }\nvar out = [];\nfor (var i = 1; i < lines.length; i++) {\n  var m = lines[i].match(/^\"([^\"]*)\",\"((?:[^\"]|\"\")*)\",(\\d+),\"((?:[^\"]|\"\")*)\"$/);\n  if (!m) continue;\n  var draft = m[4].replace(/\"\"/g, '\"');\n  if (!draft.trim()) continue;\n  if (sentIds[m[1]]) continue;\n  out.push({ json: { reviewId: m[1], draft: draft } });\n}\nreturn out;"
      }
    },
