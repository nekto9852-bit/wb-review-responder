      ],
      "parameters": {
        "jsCode": "// Node: Build Result (done branch of the real path) — full audit log: previous rows + this run (sent=true).\nvar ts = new Date().toISOString();\nvar rows = [\"reviewId,draft,sent,dry_run,timestamp\"];\ntry {\n  var prev = $(\"Parse Sent Log\").all();\n  for (var p = 0; p < prev.length; p++) {\n    var r = prev[p].json;\n    rows.push('\"' + r.reviewId + '\",\"' + String(r.draft || \"\").replace(/\"/g, '\"\"') + '\",' + r.sent + ',' + r.dry_run + ',' + (r.timestamp || \"\"));\n  }\n} catch (e) { /* no previous log */ }\nvar sent = $(\"Prepare Items\").all();\nfor (var i = 0; i < sent.length; i++) {\n  var x = sent[i].json;\n  rows.push('\"' + x.reviewId + '\",\"' + String(x.draft).replace(/\"/g, '\"\"') + '\",true,false,' + ts);\n}\nreturn [{ json: { csv: rows.join(\"\\n\"), total: sent.length, sent: sent.length, dry_run: false, mode: \"real\" } }];"
      }
    },
