    {
      "id": "dry2",
      "name": "Dry Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        304
      ],
      "parameters": {
        "jsCode": "// Node: Dry Log v2 (code, runOnceForAllItems) — WF2 stateless confirm\n// Input: { body: { answer, csv } } — csv is the drafts CSV text from the confirm request.\nvar src = $(\"Webhook\").first().json; var body = src.body || src;\nvar csvText = String(body.csv || \"\");\nvar lines = csvText.trim().split(\"\\n\");\nvar out = [];\nvar ts = new Date().toISOString();\nvar rows = [\"reviewId,draft,sent,dry_run,timestamp\"];\nvar empty = 0;\nfor (var i = 1; i < lines.length; i++) {\n  // format: \"reviewId\",\"text\",rating,\"draftAnswer\"\n  var m = lines[i].match(/^\"([^\"]*)\",\"((?:[^\"]|\"\")*)\",(\\d+),\"((?:[^\"]|\"\")*)\"$/);\n  if (!m) continue;\n  var draft = m[4].replace(/\"\"/g, '\"');\n  if (!draft.trim()) { empty++; continue; }\n  rows.push('\"' + m[1] + '\",\"' + draft.replace(/\"/g, '\"\"') + '\",false,true,' + ts);\n  out.push({ json: { reviewId: m[1], draftAnswer: draft } });\n}\nreturn [{ json: {\n  csv: rows.join(\"\\n\"),\n  total: out.length,\n  skippedEmpty: empty,\n  sent: 0,\n  dry_run: true,\n  mode: \"dry_run (WB_API_TOKEN not set)\"\n}}];\n"
      }
    },
