    {
      "id": "chk2",
      "name": "Check Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// Node: Check Answer (code, runOnceForAllItems) — replaces brittle IF for webhook body variants.\nvar body = $input.first().json.body;\nif (body === undefined || body === null) body = $input.first().json;\nvar answer = \"\";\ntry { answer = String(typeof body === \"string\" ? JSON.parse(body).answer : body.answer || \"\"); } catch (e) { answer = String(body || \"\"); }\nanswer = answer.toLowerCase().trim();\nif (answer.indexOf(\"да\") >= 0 || answer.indexOf(\"yes\") >= 0) {\n  return [{ json: { approved: true, answer: answer } }];\n}\nreturn [];\n"
      }
    },
